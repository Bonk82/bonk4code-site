---
interface Props {
  variant?: 'wave' | 'glow' | 'mesh';
  class?: string;
}
const { variant = 'glow', class: className = '' } = Astro.props;
---

{variant === 'wave' && (
  <div class={`relative h-px w-full ${className}`} aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>
  </div>
)}

{variant === 'glow' && (
  <div
    class={`relative mx-auto h-px w-full max-w-7xl ${className}`}
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-border to-transparent"></div>
    <div class="absolute left-1/2 top-1/2 h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/20 blur-2xl"></div>
  </div>
)}

{variant === 'mesh' && (
  <div class={`relative h-24 w-full overflow-hidden ${className}`} aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_50%,hsl(var(--primary)/0.18),transparent_40%),radial-gradient(circle_at_75%_50%,hsl(var(--accent)/0.18),transparent_40%)]"></div>
  </div>
)}
